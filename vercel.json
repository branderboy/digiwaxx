{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" }
  ],
  "redirects": [
    { "source": "/ko", "destination": "/ko/us-dj-promotion-for-korean-labels", "permanent": false },
    { "source": "/es", "destination": "/es/promocion-dj-estados-unidos", "permanent": false }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(admin|funnel|index|submit)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
